params {
    samples = ['SRR10379721', 'SRR10379722', 'SRR10379723',
               'SRR10379724', 'SRR10379725', 'SRR10379726']
    ref_id  = 'CP000253.1'
    adapter = 'AGATCGGAAGAGC'   // adaptateur Illumina TruSeq (kit cité dans l'article)
    design  = "${projectDir}/samples.csv"   // plan d'expérience (source : GEO GSE139659)
    datadir = "${projectDir}/data"
    outdir  = "${projectDir}/results"
}

apptainer {
    enabled    = true
    autoMounts = true
}

// Une image Apptainer par outil : recettes dans container/,
// images construites dans images/ par build_images.sh
process {
    withName: 'DOWNLOAD_FASTQ|DOWNLOAD_GENOME' { container = "${projectDir}/images/wget_1.21.3.sif" }
    withName: 'BOWTIE_INDEX'                   { container = "${projectDir}/images/bowtie_0.12.7.sif" }
    withName: 'TRIM'                           { container = "${projectDir}/images/cutadapt_1.11.sif" }
    withName: 'MAPPING' {
        container = "${projectDir}/images/bowtie_0.12.7.sif"
        cpus      = 4
    }
    withName: 'COUNT' {
        container = "${projectDir}/images/subread_1.4.6-p3.sif"
        cpus      = 4
    }
    withName: 'DESEQ2' { container = "${projectDir}/images/deseq2_1.16.1.sif" }
}

