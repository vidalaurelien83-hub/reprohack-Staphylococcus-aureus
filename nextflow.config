params {
    samples = ['SRR10379721', 'SRR10379722', 'SRR10379723',
               'SRR10379724', 'SRR10379725', 'SRR10379726']
    ref_id  = 'CP000253.1'
    datadir = "${projectDir}/data"
    outdir  = "${projectDir}/results"
}

apptainer {
    enabled    = true
    autoMounts = true
}

// À COMPLÉTER avec les chemins des images trouvées via damona
process {
    withName: 'DOWNLOAD_FASTQ|DOWNLOAD_GENOME' { container = 'images/IMAGE_AVEC_WGET.img' }
    withName: 'BOWTIE_INDEX'                   { container = 'images/bowtie_0.12.7.img' }
    withName: 'TRIM'                           { container = 'images/cutadapt_1.11.img' }
}